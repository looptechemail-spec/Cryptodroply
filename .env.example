# Database (su Railway: riferimento al servizio Postgres, ${{Postgres.DATABASE_URL}})
DATABASE_URL=postgresql://user:password@localhost:5432/cryptodroply

# Sito
SITE_URL=https://www.cryptodroply.com
AUTH_SECRET=change-me-with-a-long-random-string

# Stripe: unico piano PRO a 14 EUR/mese
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# Email transazionali e newsletter (Resend o Brevo)
EMAIL_FROM=info@cryptodroply.com
RESEND_API_KEY=

# Storage immagini S3-compatibile (Cloudflare R2)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Chiave per le chiamate di n8n alle API del sito (si genera dal pannello admin)
# N8N_WEBHOOK_URL=
